{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "webAppName": {
      "value": "sharecloud-app"
    },
    "sku": {
      "value": "B1"
    },
    "azureStorageAccountName": {
      "value": "YOUR_STORAGE_ACCOUNT_NAME"
    },
    "azureStorageContainerName": {
      "value": "files"
    },
    "azureStorageTrashContainerName": {
      "value": "trash"
    },
    "azureAdClientId": {
      "value": "YOUR_AZURE_AD_CLIENT_ID"
    },
    "azureAdClientSecret": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RG/providers/Microsoft.KeyVault/vaults/YOUR_KEYVAULT"
        },
        "secretName": "azure-ad-client-secret"
      }
    },
    "azureAdTenantId": {
      "value": "YOUR_AZURE_AD_TENANT_ID"
    },
    "nextAuthSecret": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RG/providers/Microsoft.KeyVault/vaults/YOUR_KEYVAULT"
        },
        "secretName": "nextauth-secret"
      }
    },
    "nextAuthUrl": {
      "value": "https://YOUR_APP_NAME.azurewebsites.net"
    },
    "cleanupApiKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RG/providers/Microsoft.KeyVault/vaults/YOUR_KEYVAULT"
        },
        "secretName": "cleanup-api-key"
      }
    }
  }
}
